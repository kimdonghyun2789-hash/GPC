# GPC IP Lens 환경설정 예시
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 절대 커밋하지 말 것)
# Settings 화면에서 입력해도 됩니다 (DB 저장값이 .env 보다 우선).

# Google Gemini API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# KIPRISPlus API Key (https://plus.kipris.or.kr)
KIPRIS_API_KEY=

# KIPRISPlus REST Base URL (예: http://plus.kipris.or.kr/openapi/rest)
KIPRIS_BASE_URL=

# true 면 sample_patents.csv 기반 mock 모드로 동작
USE_MOCK_DATA=true
