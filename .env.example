# MML (머물래) - 환경변수 예시 파일
# 이 파일을 복사해서 .env 로 저장한 뒤 값을 채우면 된다.
# API Key는 코드에 하드코딩하지 않고 여기(.env) 또는 Streamlit secrets로 관리한다.
# AI Key가 없어도 MML의 기본 추천 기능은 정상 동작한다.

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# 네이버 지도(NAVER Cloud Platform Maps) - 선택 기능
# 주소->좌표 변환, 정적 지도 미리보기에 사용한다.
# (키가 없어도 '네이버 지도에서 보기' 링크는 동작하며, 기본 추천도 정상 동작한다.)
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=
